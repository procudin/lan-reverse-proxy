#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

CONFIG_NAME=lan_reverse_proxy
CONFIG_FILE=/var/run/lan-reverse-proxy/nginx.conf
GENERATOR=/usr/lib/lan-reverse-proxy/generate-config

proxy_enabled() {
	local enabled
	config_load "$CONFIG_NAME"
	# Configurations created before this option existed remain enabled.
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ]
}

write_config() {
	mkdir -p "${CONFIG_FILE%/*}"
	chmod 700 "${CONFIG_FILE%/*}"
	temporary="${CONFIG_FILE}.tmp"
	umask 077
	if ! "$GENERATOR" > "$temporary"; then
		rm -f "$temporary"
		logger -t lan-reverse-proxy "Configuration is invalid"
		return 1
	fi
	chmod 600 "$temporary"
	if ! /usr/sbin/nginx -t -c "$temporary"; then
		rm -f "$temporary"
		return 1
	fi
	mv "$temporary" "$CONFIG_FILE"
}

start_service() {
	proxy_enabled || return 0
	write_config || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/nginx -c "$CONFIG_FILE" -g 'daemon off;'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	if ! proxy_enabled; then
		# Remove instances but retain config triggers so Save & Apply can re-enable us.
		rc_procd start_service
		return
	fi
	write_config || return 1
	if /usr/sbin/nginx -s reload -c "$CONFIG_FILE"; then
		return 0
	fi
	/etc/init.d/lan-reverse-proxy start
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG_NAME"
	# Keep the subscription valid when the selected interfaces change on reload.
	# The generator still permits only subnets of the currently selected interfaces.
	procd_add_raw_trigger "interface.*" 1000 /etc/init.d/lan-reverse-proxy reload
}
